{
  "name": "@ruivalim/catalog-cleanup",
  "version": "0.1.6",
  "description": "A Backstage plugin to manage and cleanup catalog locations",
  "main": "dist/index.esm.js",
  "types": "dist/index.d.ts",
  "license": "Apache-2.0",
  "private": false,
  "publishConfig": {
    "access": "public",
    "main": "dist/index.esm.js",
    "types": "dist/index.d.ts"
  },
  "sideEffects": false,
  "backstage": {
    "role": "frontend-plugin",
    "pluginId": "catalog-cleanup",
    "pluginPackages": [
      "@ruivalim/catalog-cleanup"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ruivalim/catalog-cleanup.git",
    "directory": "."
  },
  "scripts": {
    "start": "backstage-cli package start",
    "build": "yarn run tsc:generate-types && backstage-cli package build",
    "tsc:generate-types": "node -e \"const ts = require('typescript'); const config = require('./tsconfig.json'); const program = ts.createProgram(['src/index.ts'], {...config.compilerOptions, declaration: true, emitDeclarationOnly: true, outDir: 'dist-types', rootDir: '.', skipLibCheck: true}); program.emit();\"",
    "lint": "backstage-cli package lint",
    "test": "backstage-cli package test",
    "clean": "backstage-cli package clean",
    "prepack": "backstage-cli package prepack",
    "postpack": "backstage-cli package postpack"
  },
  "keywords": [
    "backstage",
    "catalog",
    "cleanup",
    "locations",
    "backstage-plugin",
    "frontend"
  ],
  "author": "Rui Valim",
  "dependencies": {
    "@backstage/core-components": "^0.15.1",
    "@backstage/core-plugin-api": "^1.10.1",
    "@backstage/plugin-catalog-react": "^1.14.0",
    "@backstage/plugin-permission-common": "^0.9.3",
    "@backstage/plugin-permission-react": "^0.4.39",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@material-ui/lab": "^4.0.0-alpha.61",
    "react-use": "^17.5.1"
  },
  "peerDependencies": {
    "react": "^16.13.1 || ^17.0.0 || ^18.0.0"
  },
  "files": [
    "dist"
  ],
  "devDependencies": {
    "@backstage/cli": "^0.27.0",
    "@backstage/core-app-api": "^1.16.0",
    "@backstage/dev-utils": "^1.1.8",
    "@backstage/test-utils": "^1.7.1",
    "@spotify/eslint-config-base": "^15.0.0",
    "@spotify/eslint-config-react": "^15.0.0",
    "@spotify/eslint-config-typescript": "^15.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^14.3.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.7",
    "@typescript-eslint/eslint-plugin": "^5.0.0",
    "@typescript-eslint/parser": "^5.0.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^29.11.2",
    "eslint-plugin-jsx-a11y": "^6.0.0",
    "eslint-plugin-react": "^7.7.0",
    "eslint-plugin-react-hooks": "^4.0.0",
    "react": "^18.0.0",
    "typescript": "~5.3.0"
  },
  "bugs": {
    "url": "https://github.com/Ruivalim/catalog-cleanup/issues"
  },
  "homepage": "https://github.com/Ruivalim/catalog-cleanup#readme",
  "module": "./dist/index.esm.js"
}
